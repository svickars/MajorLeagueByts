# Tidbyt credentials (required)
TIDBYT_API_TOKEN=
TIDBYT_DEVICE_ID=

# Team to follow (Blue Jays by default)
TEAM_ID=141
TEAM_ABBR=TOR

# Display preferences
TIMEZONE=America/Vancouver
TIDBYT_INSTALLATION_ID=MajorLeagueByts

# Fast-loop tuning (used during live games)
PUSH_INTERVAL_SEC=90
MAX_FAST_MINUTES=360
